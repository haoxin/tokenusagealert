    "mspOfferDescription": {
      "type": "string",
      "defaultValue": "Read-only discovery and Azure Monitor metrics collection for Azure OpenAI cost estimation.",
      "metadata": {
        "description": "Description shown to the customer for this delegation."
      }
    }
  },
  "variables": {
    "readerRoleDefinitionId": "acdd72a7-3385-48ef-bd42-f606fba81ae7",
    "deleteAssignmentRoleDefinitionId": "91c1777a-f3dc-4fae-b103-61d183457e46",
    "registrationDefinitionName": "[guid(parameters('managedByTenantId'), parameters('collectorPrincipalId'), subscription().subscriptionId, parameters('mspOfferName'))]"
  },
  "resources": [
